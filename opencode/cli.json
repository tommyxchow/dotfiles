{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "keybinds": {
    "prompt.stash": "ctrl+s,super+s",
    "prompt.stash.list": "ctrl+l",
    "input.select.all": "ctrl+a,super+a",
    "input.select.word.forward": "alt+shift+f,alt+shift+right,ctrl+shift+right",
    "input.select.word.backward": "alt+shift+b,alt+shift+left,ctrl+shift+left",
    "input.redo": "ctrl+shift+z,ctrl+y,super+shift+z",
    "input.line.home": "super+left",
    "input.line.end": "ctrl+e,super+right",
    "input.buffer.home": "home,super+up",
    "input.buffer.end": "end,super+down",
    "session.first": "none",
    "session.last": "none"
  },
  "attention": {
    "enabled": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true
  },
  "prompt": {
    "image_preview": true
  }
}
