{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "keybinds": {
    "prompt.stash": "ctrl+s",
    "prompt.stash.list": "ctrl+l",
    "input.select.all": "ctrl+a",
    "input.line.home": "none",
    "input.buffer.home": "home",
    "input.buffer.end": "end",
    "session.first": "none",
    "session.last": "none"
  },
  "attention": {
    "enabled": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true
  },
  "prompt": {
    "image_preview": true
  }
}
