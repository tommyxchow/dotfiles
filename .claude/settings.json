{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ]; then echo 'This session runs inside the Herdr desktop app (HC_TERMINAL_ID is set), so the global rule for the Herdr desktop app applies.'; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"$HOME/.claude/skills/hq/save-close.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "ek@chow": false,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chow": {
      "source": {
        "source": "github",
        "repo": "tommyxchow/dotfiles"
      },
      "autoUpdate": true
    }
  },
  "promptCacheTtl": "1h",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Linked git worktrees of the working repo, including the ones under ~/.herdr/worktrees, are part of that repo"
    ]
  }
}
