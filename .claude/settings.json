{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/herdr-agent-state\"; if [ -f \"$h.sh\" ]; then bash \"$h.sh\" session; elif [ -f \"$h.ps1\" ]; then powershell -NoProfile -ExecutionPolicy Bypass -File \"$h.ps1\" session; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "ek@chow": true,
    "improve@improve": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chow": {
      "source": {
        "source": "github",
        "repo": "tommyxchow/dotfiles"
      },
      "autoUpdate": true
    },
    "improve": {
      "source": {
        "source": "github",
        "repo": "shadcn/improve"
      }
    }
  },
  "sandbox": {
    "enabled": true
  },
  "effortLevel": "high",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
